NODE_ENV="Environment mode (development, production, test)"

PORT="Port for the Next.js web server"

HOSTNAME="Host for the Next.js server (for Docker use 0.0.0.0)"

SITE_URL="Public site base URL used for metadata, robots, and sitemap"

API_URL="Server-side API server base URL"

HOME_QUOTE_ID="Server-side id of the quote shown on the home page (optional: without it the page has no quote card)"
